# Skill Harbor — environment (copy to .env or set on host)

# development | production
SKILL_HARBOR_ENV=development

# Database (optional — default: ~/.cursor-skills-studio/harbor.db)
# Dev:
# SKILL_HARBOR_DATABASE_URL=sqlite:///%USERPROFILE%/.cursor-skills-studio/harbor.db
# Prod single-node:
# SKILL_HARBOR_DATABASE_URL=sqlite:////var/lib/harbor/harbor.db
# Prod remote (planned):
# SKILL_HARBOR_DATABASE_URL=postgresql://user:pass@host:5432/harbor

# Seed default admin admin/admin on startup (dev only — set 0 in production)
SKILL_HARBOR_SEED_DEFAULT_ADMIN=1

# GitHub token for star refresh + repo discovery (or save in admin dashboard)
# SKILL_HARBOR_ADMIN_GITHUB_TOKEN=ghp_...
